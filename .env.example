# Supabase (Project Settings > API). A chave publicável é pública por natureza;
# a proteção dos dados vem das regras RLS da migração em supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público definitivo do site, com https e sem barra no final (sitemap, robots e canônico).
NEXT_PUBLIC_SITE_URL=
